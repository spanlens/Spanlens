{
  "name": "spanlens",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean",
    "db:generate-init": "node scripts/generate-init-sql.mjs",
    "db:check-init": "node scripts/generate-init-sql.mjs --check",
    "db:local": "node scripts/local-db-setup.mjs",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check:env": "pnpm --filter server check:env"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9",
    "globals": "^16.5.0",
    "lefthook": "^2.1.14",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
