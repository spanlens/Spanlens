# Server
PORT=3001

# Supabase (local: use values printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Encryption key: generate with `openssl rand -base64 32` (must be 32 bytes).
# If misconfigured, Provider Key decryption silently fails (returns empty string).
ENCRYPTION_KEY=<32-bytes-base64-encoded-key>

# Vercel cron auth — /cron/* endpoints verify this as a Bearer token.
# Store the same value under Vercel Dashboard → Environment Variables (Vercel injects automatically).
# Dev: generate with `openssl rand -hex 32`
CRON_SECRET=

# Resend (email notifications).
# If unset, invitation links are printed to console (local dev only).
RESEND_API_KEY=
# Sender shown on outgoing email. Default: Spanlens <notifications@spanlens.io>.
# Use a verified Resend domain or mail lands in spam.
RESEND_FROM=
# Base URL for invitation accept links. Production: https://www.spanlens.io
WEB_URL=http://localhost:3000

# Internal operator allowlist for /api/v1/admin/* (comma-separated emails).
# Fail-closed: when unset, every admin route returns 403.
SPANLENS_ADMIN_EMAILS=

# GitGuardian HasMySecretLeaked (provider key leak detection — required only when leak_detection_enabled is on).
# Sign up: https://dashboard.gitguardian.com → Settings → API → Personal Access Tokens
# Free plan: 10,000 calls/month, 50 requests/minute.
# If unset, leak detection cron is a no-op.
GITGUARDIAN_API_KEY=

# Paddle (Merchant of Record, billing, Phase 2).
# Paddle instead of Stripe because Korean sole-proprietors can't onboard to Stripe + Paddle handles global VAT/tax automatically.
# API key: Paddle Dashboard → Developer Tools → Authentication → API Keys
# Notification secret: Paddle Dashboard → Developer Tools → Notifications → secret (webhook signature verification)
PADDLE_API_KEY=
PADDLE_NOTIFICATION_SECRET=
# 'sandbox' for Paddle Sandbox, 'production' for live billing.
PADDLE_ENVIRONMENT=sandbox
# Paddle price IDs (Dashboard → Catalog → Products). Checkout rejects every
# plan as "unconfigured" without the plan prices; overage billing is skipped
# without the overage ones.
# Sandbox and production use DIFFERENT price IDs — keep them per-environment.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=
PADDLE_PRICE_STARTER_OVERAGE=
PADDLE_PRICE_TEAM_OVERAGE=

# Sentry — error monitoring (https://sentry.io).
# Create two projects: spanlens-server (Node) + spanlens-web (Next.js).
# Leave blank to disable Sentry (local dev default).
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=spanlens-server
SENTRY_AUTH_TOKEN=

# Upstash for Redis — rate limiting (sliding window).
# Auto-injected when connecting Vercel Storage → "upstash-kv-aqua-flask".
# Local dev: if unset, rate limit fails open (always allows).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pooled Postgres connection for the `requests` table.
#
# The rest of the server talks to Postgres through PostgREST (the SUPABASE_*
# vars above), which is the right tool for row-shaped CRUD. It cannot express
# the analytics the request log needs — percentiles, FILTER clauses, grouped
# date truncation — and it has no cursor, so a large CSV export would have to
# be held in memory. Hence a direct connection, used only for that table.
#
# Use the TRANSACTION-mode pooler on port 6543, not 5432. Supabase Dashboard →
# Project Settings → Database → Connection string → Transaction pooler.
# Session mode (5432) pins a backend per client, which a horizontally-scaled
# function exhausts within a few dozen cold starts. Migrations are the one
# exception and use the direct port, but those run through the Supabase CLI.
#
# Copy the host from the dashboard rather than assembling it. The shared
# pooler hostname carries a numbered prefix that is not derivable from the
# region, and guessing it produces a "tenant or user not found" error that
# reads like a credentials problem.
#
# This is a full database credential. Never log it, not even truncated.
SUPABASE_DB_POOLER_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Optional. Connections held per function instance. Defaults to 2. Raising this
# multiplies across instances rather than adding throughput — Vercel scales out,
# not up, so a large per-instance pool is how you exhaust the pooler.
# PG_POOL_MAX=2

# Optional. Server-side statement timeout in milliseconds, defaults to 60000.
# Bounds a runaway dashboard query so it cannot starve the proxy's auth path,
# which shares this database.
# PG_STATEMENT_TIMEOUT_MS=60000

# 4B.2 — Spanlens dogfoods itself. When both vars are set the
# eval-runner posts a `eval_run` trace to a dedicated "spanlens-team"
# workspace so we can see our own LLM-judge cost / latency / errors in
# /traces alongside customer data. Leave blank locally and in CI — the
# tracing helper degrades to no-op so nothing leaks to production.
#
# SPANLENS_INTERNAL_BASE_URL=https://api.spanlens.io
# SPANLENS_INTERNAL_API_KEY=sl_live_<hex>
SPANLENS_INTERNAL_BASE_URL=
SPANLENS_INTERNAL_API_KEY=

# Better Stack heartbeat URLs (optional, per-cron opt-in — lib/cron-heartbeat.ts).
# Unset = no-op. Key rule: HEARTBEAT_<job-name with - replaced by _, uppercased>.
HEARTBEAT_REPLAY_FALLBACK=
HEARTBEAT_SELF_MONITOR=
HEARTBEAT_EXECUTE_PENDING_DELETIONS=
HEARTBEAT_EVALUATE_ALERTS=
